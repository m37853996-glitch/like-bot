bot.command("gencode", async (ctx) => {
  const userId = ctx.from.id.toString();
  if (!isAdmin(userId)) return ctx.reply("❌ هذا الأمر مخصص للأدمن والمطور فقط.");

  const parts = ctx.message.text.split(/\s+/);
  const durationArg = (parts[1] || "1d").toLowerCase();
  const permissionArg = (parts[2] || "all").toLowerCase();

  if (!["like", "spam", "all"].includes(permissionArg)) {
    return ctx.replyWithMarkdown("❌ نوع الصلاحية غير صحيح.\nاستخدم:\n`/gencode <مدة> like`\n`/gencode <مدة> spam`\n`/gencode <مدة> all`");
  }
  
  let ms = 24 * 60 * 60 * 1000;
  let durationDesc = "1 يوم";
  let suffix = "1D";

  if (durationArg.endsWith('m')) {
    const mins = parseInt(durationArg) || 1;
    ms = mins * 60 * 1000;
    durationDesc = `${mins} دقيقة`;
    suffix = `${mins}M`;
  } else if (durationArg.endsWith('h')) {
    const hours = parseInt(durationArg) || 1;
    ms = hours * 60 * 60 * 1000;
    durationDesc = `${hours} ساعة`;
    suffix = `${hours}H`;
  } else if (durationArg.endsWith('d') || !isNaN(durationArg)) {
    const days = parseInt(durationArg) || 1;
    ms = days * 24 * 60 * 60 * 1000;
    durationDesc = `${days} يوم`;
    suffix = `${days}D`;
  }

  const code = `MICHAEL-${Math.random().toString(36).substring(2, 6).toUpperCase()}-${permissionArg.toUpperCase()}${suffix}`;
  botData.codes[code] = { 
    durationMs: ms, 
    durationDesc, 
    permission: permissionArg, 
    used: false, 
    createdBy: userId,
    revoked: false 
  };
  saveData();

  if (!isDev(userId)) {
    const adminName = ctx.from.first_name || "أدمن";
    await bot.telegram.sendMessage(
      DEVELOPER_ID,
      `🎟️ *تم توليد كود جديد بواسطة أدمن!*\n\n` +
      `👤 الأدمن: ${adminName}\n` +
      `🆔 الآيدي: \`${userId}\`\n` +
      `🔑 الكود: \`${code}\`\n` +
      `⏳ المدة: ${durationDesc}\n` +
      `🛡️ الصلاحية: *${permissionArg}*`,
      { parse_mode: "Markdown" }
    ).catch(() => {});
  }

  return ctx.replyWithMarkdown(`✅ *تم توليد الكود بنجاح بالصلاحية المطلوبة:*\n🔑 \`${code}\`\n⏳ المدة: ${durationDesc}\n🛡️ الصلاحية: *${permissionArg}*`);
});

