function escapeMarkdown(text) {
  if (!text) return "";
  return text.toString()
    .replace(/\\/g, '\\\\')
    .replace(/_/g, '\\_')
    .replace(/\*/g, '\\*')
    .replace(/`/g, '\\`')
    .replace(/\[/g, '\\[') .replace(/\]/g, '\\]')
    .replace(/\(/g, '\\(') .replace(/\)/g, '\\)');
}

function getAccounts() {
