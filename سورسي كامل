function isUserActive(userId) {
  if (isAdmin(userId)) return true;
  if (!botData.activeUsers.includes(userId)) return false;
  
  let hasValidCode = false;
  let hasAnyUsedCode = false;
  for (const [codeKey, codeObj] of Object.entries(botData.codes || {})) {
    if (codeObj.usedBy === userId) {
      hasAnyUsedCode = true;
      if (!codeObj.revoked && !codeObj.cloaked) {
        hasValidCode = true;
        break;
      }
    }
  }
  if (hasAnyUsedCode && !hasValidCode) {
    return false;
  }

  const expiry = botData.userExpiry[userId];
  if (expiry && expiry < Date.now()) return false;
  return true;
}

