bot.command("remgroup", async (ctx) => {
  if (!isAdmin(ctx.from.id)) return ctx.reply("❌ هذا الأمر مخصص للأدمن والمطور فقط.");
  const parts = ctx.message.text.split(/\s+/);
  let gInput = parts[1];
  if (!gInput) return ctx.replyWithMarkdown("⚠️ *الاستخدام الصحيح:*\n`/remgroup <group_id_or_link>`");

  let gId = "";
  if (/^-?\d+$/.test(gInput)) {
    gId = gInput;
  } else {
    let searchTarget = gInput;
    if (gInput.includes("t.me/")) {
      let clean = gInput.split("t.me/")[1];
      clean = clean.split("?")[0].split("/")[0].trim();
      searchTarget = clean.startsWith("+") ? clean : (clean.startsWith("@") ? clean : "@" + clean);
    } else if (!gInput.startsWith("@")) {
      searchTarget = "@" + gInput;
    }
    
    for (const [id, rec] of Object.entries(botData.groupJoinRecords || {})) {
      if (rec.username && rec.username.toLowerCase() === searchTarget.toLowerCase()) {
        gId = id;
        break;
      }
    }

    if (!gId) {
      try {
        const chatInfo = await ctx.telegram.getChat(searchTarget);
        gId = chatInfo.id.toString();
      } catch (e) {
        for (const activeId of botData.activeGroups) {
          if (activeId === gInput || (botData.groupJoinRecords[activeId] && botData.groupJoinRecords[activeId].username.includes(gInput))) {
            gId = activeId;
            break;
          }
        }
      }
    }
  }

  if (!gId) {
    return ctx.reply("❌ تعذر العثور على القروب. يرجى استخدام الآيدي الرقمي مباشرة مثل (-100xxxx).");
  }

  const idx = botData.activeGroups.indexOf(gId);
  if (idx !== -1) {
    botData.activeGroups.splice(idx, 1);
    delete botData.groupExpiry[gId];
    delete botData.groupActivationTimes[gId];
    delete botData.groupJoinRecords[gId];
    
    for (const [uId, gList] of Object.entries(botData.userGroups || {})) {
      const gIdx = gList.indexOf(gId);
      if (gIdx !== -1) {
        gList.splice(gIdx, 1);
      }
    }

    saveData();
    return ctx.replyWithMarkdown(`🔴 *تم إزالة القروب بنجاح!*`);
  }
  
  return ctx.replyWithMarkdown(`⚠️ القروب غير موجود في قائمة المجموعات النشطة.`);
});

