let autoLikeRunning = false;
setInterval(async () => {
  if (autoLikeRunning) return;
  autoLikeRunning = true;
  try {
    if (botData.botStatus !== "work") return;
    const DAY_MS = 24 * 60 * 60 * 1000;

    for (const uid of Object.keys(botData.autoLikes || {})) {
      const entry = botData.autoLikes[uid];
      if (!entry) continue;
      const ownerId = String(entry.userId);

      if (ownerId !== DEVELOPER_ID && !isUserActive(ownerId)) {
        delete botData.autoLikes[uid];
        saveData();
        await bot.telegram.sendMessage(ownerId, `⚠️ تم إيقاف AUTO LIKE للآيدي (${uid}) بسبب انتهاء اشتراكك.\n\n⚡ MICHAEL ELITE`).catch(() => {});
        continue;
      }

      if (entry.lastSent && Date.now() - entry.lastSent < DAY_MS) continue;
      if (entry.nextTry && Date.now() < entry.nextTry) continue;

      try {
        const result = await enqueueLikeTask(uid);
        entry.lastSent = Date.now();
        entry.failCount = 0;
        entry.nextTry = 0;
        entry.daysLeft -= 1;
        
        updateGlobalTargetCooldown(uid);

        const finished = entry.daysLeft <= 0;
        const daysLeftNow = entry.daysLeft;
        if (finished) delete botData.autoLikes[uid];
        saveData();

        await bot.telegram.sendMessage(ownerId,
          `🤖 AUTO LIKE\n\n` +
          `👤 Player: ${result.nickname}\n` +
          `🆔 UID: \`${uid}\`\n` +
          `📉 Before: \`${result.beforeLikes}\`\n` +
          `🔥 Likes Given: +${result.addedLikes}\n` +
          `📈 After: \`${result.afterLikes}\`\n\n` +
          (finished ? `✅ انتهت مدة AUTO LIKE لهذا الآيدي.\n\n` : `⏳ الأيام المتبقية: ${daysLeftNow}\n\n`) +
          `⚡ MICHAEL ELITE`,
          { parse_mode: "Markdown" }
        ).catch(() => {});
      } catch (err) {
        if (err && err.message === "INVALID_UID") {
          entry.failCount = (entry.failCount || 0) + 1;
          entry.nextTry = Date.now() + 30 * 60 * 1000;
          if (entry.failCount >= 3) {
            delete botData.autoLikes[uid];
            saveData();
            await bot.telegram.sendMessage(ownerId, `⚠️ تم حذف الآيدي (${uid}) من AUTO LIKE لأنه غير صالح.\n\n⚡ MICHAEL ELITE`).catch(() => {});
          } else {
            saveData();
          }
        } else if (err && err.message !== "DUPLICATE_UID" && err.message !== "QUEUE_FULL") {
          entry.nextTry = Date.now() + 10 * 60 * 1000;
          saveData();
        }
      }
    }
  } catch (e) {
  } finally {
    autoLikeRunning = false;
  }
}, 60 * 1000);

