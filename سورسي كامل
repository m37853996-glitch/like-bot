async function processRedeem(ctx, codeText) {
  const code = codeText.trim();
  if (!botData.codes[code]) return ctx.reply("❌ الكود غير صحيح أو غير موجود.");
  if (botData.codes[code].used) return ctx.reply("❌ تم استخدام هذا الكود مسبقاً.");

  const userId = ctx.from.id.toString();
  const userName = ctx.from.first_name || "مستخدم";
  const codeData = botData.codes[code];
  
  codeData.used = true;
  codeData.usedBy = userId;
  codeData.usedByName = userName;
  codeData.revoked = false;

  const now = Date.now();
  const currentExpiry = (botData.userExpiry[userId] && botData.userExpiry[userId] > now) ? botData.userExpiry[userId] : now;
  const newExpiry = currentExpiry + codeData.durationMs;

  botData.userExpiry[userId] = newExpiry;
  if (!botData.activeUsers.includes(userId)) botData.activeUsers.push(userId);
  
  if (!botData.userPermissions) botData.userPermissions = {};
  botData.userPermissions[userId] = codeData.permission || "all";
  
  if (botData.userExpiryNotified) {
    botData.userExpiryNotified = botData.userExpiryNotified.filter(id => id !== userId);
  }
  
  saveData();

  const successMsg = 
    `🎟️ *تم استخدام كود تفعيل بنجاح!*\n\n` +
    `👤 المستخدم: ${userName}\n` +
    `🆔 الآيدي: \`${userId}\`\n` +
    `🔑 نوع الصلاحية: \`${codeData.permission || 'all'}\`\n` +
    `🔑 الكود المستهلك: \`${code}\``;

  bot.telegram.sendMessage(DEVELOPER_ID, successMsg, { parse_mode: "Markdown" }).catch(() => {});

  if (codeData.createdBy && codeData.createdBy !== DEVELOPER_ID) {
    bot.telegram.sendMessage(codeData.createdBy, successMsg, { parse_mode: "Markdown" }).catch(() => {});
  }

  return ctx.replyWithMarkdown(`🎉 مبروك! تم تفعيل اشتراكك بنجاح (نوع الصلاحية: ${codeData.permission || 'all'}) حتى: ${new Date(newExpiry).toLocaleString()}`);
}
